{
  "name": "@tamagui/tailwind-coverage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "catalog": "bun src/catalog.ts",
    "signatures": "bun src/signatures.ts",
    "native-contract": "bun src/reactNativeContract.ts",
    "report:lowering": "bun src/loweringComparison.ts",
    "check:catalog": "bun src/catalog.ts --check",
    "check:signatures": "bun src/signatures.ts --check",
    "check:native-contract": "bun src/reactNativeContract.ts --check",
    "check:lowering-report": "bun src/loweringComparison.ts --check",
    "test": "bun test --timeout 30000",
    "check": "bun run check:catalog && bun run check:signatures && bun run check:native-contract && bun run check:lowering-report && bun run test"
  },
  "dependencies": {
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
